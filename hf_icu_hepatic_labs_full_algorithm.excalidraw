    {
      "id": "sec6-hdr",
      "type": "rectangle",
      "x": 680, "y": 1350,
      "width": 580, "height": 36,
      "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#0c8599",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100,
      "roundness": { "type": 3 },
