      "type": "text",
      "x": 2450, "y": 648,
      "width": 80, "height": 36,
      "text": "<3×\n(Mild)",
      "fontSize": 10, "fontFamily": 1,
      "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#862e9c", "backgroundColor": "transparent",
      "fillStyle": "solid", "angle": 0, "roughness": 0, "opacity": 100,
