    {
      "id": "s1-indirect-box",
      "type": "rectangle",
      "x": 20, "y": 720,
      "width": 260, "height": 300,
      "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#ebfbee",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100,
