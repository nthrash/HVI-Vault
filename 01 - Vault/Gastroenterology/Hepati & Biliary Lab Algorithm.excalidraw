			"updated": 1779011435868,
			"link": null,
			"locked": false,
			"text": "PROGNOSIS (SURVIVE trial): Elevated ALP correlated with systemic congestion\n+ elevated right-sided pressures. Predicted 180-day mortality 34.9% vs 23.5%\n(p=0.001) in ADHF. [Nikolaou 2013]",
			"fontSize": 12,
			"fontFamily": 6,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "PROGNOSIS (SURVIVE trial): Elevated ALP correlated with systemic congestion\n+ elevated right-sided pressures. Predicted 180-day mortality 34.9% vs 23.5%\n(p=0.001) in ADHF. [Nikolaou 2013]",
			"autoResize": true,
