			"isDeleted": false,
			"boundElements": [],
			"updated": 1779011437170,
			"link": null,
			"locked": false,
			"text": "PROGNOSIS: INR = independent predictor of all-cause mortality in ADHF\n(HR 1.89 per 0.1 increase) — higher prognostic value than MELD or MELD-XI.\nINR + TBili + Albumin = hepatic synthetic function triad. [Okada 2016]",
			"fontSize": 12,
			"fontFamily": 6,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "PROGNOSIS: INR = independent predictor of all-cause mortality in ADHF\n(HR 1.89 per 0.1 increase) — higher prognostic value than MELD or MELD-XI.\nINR + TBili + Albumin = hepatic synthetic function triad. [Okada 2016]",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
