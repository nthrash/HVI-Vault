			"type": "text",
			"x": 30,
			"y": 565,
			"width": 234.3279432896129,
			"height": 267.2743673506694,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
