			"type": "text",
			"x": 1872,
			"y": 852,
			"width": 602.2202970304437,
			"height": 65,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
