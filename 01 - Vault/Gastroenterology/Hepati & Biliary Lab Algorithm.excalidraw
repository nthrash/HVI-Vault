			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "synth_d",
			"type": "text",
			"x": 32.32697599999983,
			"y": 2304.515994,
			"width": 876.23095703125,
			"height": 17.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0e",
			"roundness": null,
			"seed": 334414932,
			"version": 233,
			"versionNonce": 1830277342,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1779011437170,
			"link": null,
			"locked": false,
			"text": "Child-Pugh: Albumin low + INR up + ascites + encephalopathy + bilirubin -> grades A/B/C hepatic reserve. Useful for cirrhosis assessment.",
			"fontSize": 14,
			"fontFamily": 6,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Child-Pugh: Albumin low + INR up + ascites + encephalopathy + bilirubin -> grades A/B/C hepatic reserve. Useful for cirrhosis assessment.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "synth_e",
			"type": "text",
			"x": 32.32697599999983,
			"y": 2330.515994,
			"width": 1927.8115234375,
			"height": 17.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0f",
			"roundness": null,
			"seed": 2056084204,
			"version": 236,
			"versionNonce": 1871631170,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1779011584240,
			"locked": false,
			"text": "Platelets low + splenomegaly -> portal hypertension / cardiac cirrhosis? Pre-LVAD/transplant: persistent hyperbilirubinemia + abnormal imaging -> liver biopsy may be required. Noninvasive tools (liver stiffness / MRE) CANNOT reliably distinguish congestion from fibrosis in this population. [Lemmer 2018]",
			"fontSize": 14,
			"fontFamily": 6,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Platelets low + splenomegaly -> portal hypertension / cardiac cirrhosis? Pre-LVAD/transplant: persistent hyperbilirubinemia + abnormal imaging -> liver biopsy may be required. Noninvasive tools (liver stiffness / MRE) CANNOT reliably distinguish congestion from fibrosis in this population. [Lemmer 2018]",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": "Platelets low + splenomegaly -> portal hypertension / cardiac cirrhosis? Pre-LVAD/transplant: persistent hyperbilirubinemia + abnormal imaging -> liver biopsy may be required. Noninvasive tools (liver stiffness / MRE) CANNOT reliably distinguish congestion from fibrosis in this population. [Lemmer 2018]"
		},
