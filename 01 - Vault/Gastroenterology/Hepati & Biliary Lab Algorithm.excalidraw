		{
			"id": "s5_t",
			"type": "text",
			"x": 28.32697599999983,
			"y": 1526.5159939999999,
			"width": 116.28793334960938,
			"height": 20,
			"angle": 0,
			"strokeColor": "#b91c1c",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0G",
