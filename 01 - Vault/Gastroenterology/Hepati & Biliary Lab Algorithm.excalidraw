		{
			"id": "s3_t",
			"type": "text",
			"x": 1272,
			"y": 410,
			"width": 116.19190979003906,
			"height": 20,
			"angle": 0,
			"strokeColor": "#15803d",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "ae",
