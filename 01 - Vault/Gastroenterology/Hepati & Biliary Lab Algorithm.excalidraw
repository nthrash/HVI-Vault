			"index": "aw",
			"roundness": null,
			"seed": 1745043052,
			"version": 27,
			"versionNonce": 1708795522,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1779011435868,
			"locked": false,
			"text": "ACLI: rapid rise d1-3 -> 50% fall within 72h of hemo stabilization -> normalization d7-10\nFailure to decline after hemodynamic stabilization -> reassess: ongoing ischemia, DILI, viral hepatitis,\nor primary liver disease\nLow AST/ALT: pyridoxine (B6) deficiency or advanced sarcopenia/cachexia",
			"fontSize": 13,
			"fontFamily": 6,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "ACLI: rapid rise d1-3 -> 50% fall within 72h of hemo stabilization -> normalization d7-10\nFailure to decline after hemodynamic stabilization -> reassess: ongoing ischemia, DILI, viral hepatitis, or primary liver disease\nLow AST/ALT: pyridoxine (B6) deficiency or advanced sarcopenia/cachexia",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": "ACLI: rapid rise d1-3 -> 50% fall within 72h of hemo stabilization -> normalization d7-10\nFailure to decline after hemodynamic stabilization -> reassess: ongoing ischemia, DILI, viral hepatitis, or primary liver disease\nLow AST/ALT: pyridoxine (B6) deficiency or advanced sarcopenia/cachexia",
			"link": null
		},
