		{
			"id": "synth_t",
			"type": "text",
			"x": 32.32697599999983,
			"y": 2226.515994,
			"width": 934.8348999023438,
			"height": 17.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0b",
			"roundness": null,
			"seed": 1186260460,
			"version": 235,
			"versionNonce": 901776414,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1779011437170,
			"link": null,
			"locked": false,
			"text": "Albumin (t1/2 ~20 days): reflects CHRONIC synthetic dysfunction. Low = congestion + inflammation + malnutrition + hemodilution + PLE + cachexia",
			"fontSize": 14,
			"fontFamily": 6,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Albumin (t1/2 ~20 days): reflects CHRONIC synthetic dysfunction. Low = congestion + inflammation + malnutrition + hemodilution + PLE + cachexia",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "synth_b",
			"type": "text",
			"x": 32.32697599999983,
			"y": 2252.515994,
			"width": 1122.3087158203125,
			"height": 17.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0c",
			"roundness": null,
			"seed": 1474674388,
			"version": 296,
			"versionNonce": 1302712414,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1779011437170,
			"locked": false,
			"text": "INR (t1/2 hours-days): reflects ACUTE synthetic failure. INR >1.5 + encephalopathy = Acute Liver Failure (ALF) criteria -> hepatology +/- transplant consult depending on etiology",
			"fontSize": 14,
			"fontFamily": 6,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "INR (t1/2 hours-days): reflects ACUTE synthetic failure. INR >1.5 + encephalopathy = Acute Liver Failure (ALF) criteria -> hepatology +/- transplant consult depending on etiology",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": "INR (t1/2 hours-days): reflects ACUTE synthetic failure. INR >1.5 + encephalopathy = Acute Liver Failure (ALF) criteria -> hepatology +/- transplant consult depending on etiology",
			"link": null
		},
		{
			"id": "synth_c",
			"type": "text",
			"x": 32.32697599999983,
			"y": 2278.515994,
			"width": 752.2470703125,
			"height": 17.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
