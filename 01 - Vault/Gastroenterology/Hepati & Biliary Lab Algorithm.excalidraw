		{
			"id": "s7_no_t",
			"type": "text",
			"x": 1516.3269759999998,
			"y": 1654.5159939999999,
			"width": 218.11978149414062,
			"height": 17.5,
			"angle": 0,
			"strokeColor": "#6d28d9",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
