		{
			"id": "s4_mas_b",
			"type": "text",
			"x": 1868,
			"y": 562,
			"width": 178.00172852789373,
			"height": 205.93967856546297,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "ak",
			"roundness": null,
			"seed": 847691628,
			"version": 217,
			"versionNonce": 686919682,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1779011435868,
			"locked": false,
			"text": "ACLI / Ischemic\nHepatitis\n2-hit model: congestion +\nhypoperfusion\n\nDx clues:\n- ALT:LDH <1.5\n- Peak d1-3\n- 50% fall in 72h\n- Prothrombin drops 80-84% (vs\nviral)\n\nRx:\n- Restore CO\n- Inotropes, MCS\n- O2 if hypoxic",
			"fontSize": 10.296983928273148,
			"fontFamily": 6,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "ACLI / Ischemic\nHepatitis\n2-hit model: congestion + hypoperfusion\n\nDx clues:\n- ALT:LDH <1.5\n- Peak d1-3\n- 50% fall in 72h\n- Prothrombin drops 80-84% (vs viral)\n\nRx:\n- Restore CO\n- Inotropes, MCS\n- O2 if hypoxic",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": "ACLI / Ischemic\nHepatitis\n2-hit model: congestion + hypoperfusion\n\nDx clues:\n- ALT:LDH <1.5\n- Peak d1-3\n- 50% fall in 72h\n- Prothrombin drops 80-84% (vs viral)\n\nRx:\n- Restore CO\n- Inotropes, MCS\n- O2 if hypoxic",
			"link": null
		},
