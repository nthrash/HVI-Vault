			"index": "aC",
			"roundness": null,
			"seed": 2116195564,
			"version": 169,
			"versionNonce": 2047077928,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778901376686,
			"locked": false,
			"text": "HF-ICU causes:\n- Mechanical hemolysis\n  (LVAD, ECMO, valves)\n- DIC / MAHA\n- Hematoma resorption\n- Gilbert syndrome\n  (TBili rarely >6)\n- Drug effects\n\nWorkup:\n- CBC + peripheral smear\n- Reticulocyte count\n- LDH, haptoglobin\n- Direct Coombs (DAT)\n- Review LVAD/ECMO hemolysis\nparameters",
			"fontSize": 13.363718367533473,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "HF-ICU causes:\n- Mechanical hemolysis\n  (LVAD, ECMO, valves)\n- DIC / MAHA\n- Hematoma resorption\n- Gilbert syndrome\n  (TBili rarely >6)\n- Drug effects\n\nWorkup:\n- CBC + peripheral smear\n- Reticulocyte count\n- LDH, haptoglobin\n- Direct Coombs (DAT)\n- Review LVAD/ECMO hemolysis parameters",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": "HF-ICU causes:\n- Mechanical hemolysis\n  (LVAD, ECMO, valves)\n- DIC / MAHA\n- Hematoma resorption\n- Gilbert syndrome\n  (TBili rarely >6)\n- Drug effects\n\nWorkup:\n- CBC + peripheral smear\n- Reticulocyte count\n- LDH, haptoglobin\n- Direct Coombs (DAT)\n- Review LVAD/ECMO hemolysis parameters"
		},
