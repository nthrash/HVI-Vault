		{
			"id": "DblHzWWg",
			"type": "text",
			"x": 1272,
			"y": 1790,
			"width": 450.5271911621094,
			"height": 45,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
