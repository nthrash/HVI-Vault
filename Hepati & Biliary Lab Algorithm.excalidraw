		{
			"id": "synth_t",
			"type": "text",
			"x": 36,
			"y": 1970,
			"width": 1004.134765625,
			"height": 17.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0b",
			"roundness": null,
			"seed": 1186260460,
			"version": 3,
			"versionNonce": 32790356,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778899783996,
			"link": null,
			"locked": false,
			"text": "Albumin (t1/2 ~20 days): reflects CHRONIC synthetic dysfunction. Low = congestion + inflammation + malnutrition + hemodilution + PLE + cachexia",
			"fontSize": 14,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Albumin (t1/2 ~20 days): reflects CHRONIC synthetic dysfunction. Low = congestion + inflammation + malnutrition + hemodilution + PLE + cachexia",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "synth_b",
			"type": "text",
			"x": 36,
			"y": 1996,
			"width": 1147.970458984375,
			"height": 17.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0c",
			"roundness": null,
			"seed": 1474674388,
			"version": 3,
			"versionNonce": 127825900,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778899783996,
			"link": null,
			"locked": false,
			"text": "INR (t1/2 hours-days): reflects ACUTE synthetic failure. INR >1.5 + encephalopathy = Acute Liver Failure (ALF) criteria -> hepatology + transplant consult immediately",
			"fontSize": 14,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "INR (t1/2 hours-days): reflects ACUTE synthetic failure. INR >1.5 + encephalopathy = Acute Liver Failure (ALF) criteria -> hepatology + transplant consult immediately",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "synth_c",
			"type": "text",
			"x": 36,
			"y": 2022,
			"width": 816.6329345703125,
			"height": 17.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0d",
			"roundness": null,
			"seed": 1366902892,
			"version": 3,
			"versionNonce": 563498196,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778899783996,
			"link": null,
			"locked": false,
			"text": "MELD-Na (TBili + INR + Cr + Na): prognostic scoring + transplant listing tool. Calculate on admission and trend serially.",
			"fontSize": 14,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "MELD-Na (TBili + INR + Cr + Na): prognostic scoring + transplant listing tool. Calculate on admission and trend serially.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "synth_d",
			"type": "text",
			"x": 36,
			"y": 2048,
			"width": 937.9847412109375,
			"height": 17.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0e",
			"roundness": null,
			"seed": 334414932,
			"version": 3,
			"versionNonce": 593533548,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778899783996,
			"link": null,
			"locked": false,
			"text": "Child-Pugh: Albumin low + INR up + ascites + encephalopathy + bilirubin -> grades A/B/C hepatic reserve. Useful for cirrhosis assessment.",
			"fontSize": 14,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Child-Pugh: Albumin low + INR up + ascites + encephalopathy + bilirubin -> grades A/B/C hepatic reserve. Useful for cirrhosis assessment.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "synth_e",
			"type": "text",
			"x": 36,
			"y": 2074,
			"width": 960.81884765625,
			"height": 17.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
