			"updated": 1778899783996,
			"link": null,
			"locked": false,
			"text": "KEY PEARLS: PVPI >0.5 = 81%/87% Sn/Sp for congestion-driven TBili  |  ALT:LDH <1.5 = ischemic hepatitis  |  Two-hit required for ACLI  |  SAAG >=1.1 = cardiac etiology of ascites",
			"fontSize": 13,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "KEY PEARLS: PVPI >0.5 = 81%/87% Sn/Sp for congestion-driven TBili  |  ALT:LDH <1.5 = ischemic hepatitis  |  Two-hit required for ACLI  |  SAAG >=1.1 = cardiac etiology of ascites",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
