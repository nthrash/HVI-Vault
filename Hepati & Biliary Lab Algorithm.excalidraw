			"isDeleted": false,
			"boundElements": [],
			"updated": 1778899783996,
			"link": null,
			"locked": false,
			"text": "-> liver biopsy may be required. Noninvasive tools (liver stiffness / MRE) CANNOT reliably distinguish congestion from fibrosis in this population. [Lemmer 2018]",
			"fontSize": 14,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "-> liver biopsy may be required. Noninvasive tools (liver stiffness / MRE) CANNOT reliably distinguish congestion from fibrosis in this population. [Lemmer 2018]",
