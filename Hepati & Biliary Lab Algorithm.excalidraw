			"isDeleted": false,
			"boundElements": [],
			"updated": 1778899783996,
			"link": null,
			"locked": false,
			"text": "Platelets low + splenomegaly -> portal hypertension / cardiac cirrhosis? Pre-LVAD/transplant: persistent hyperbilirubinemia + abnormal imaging",
			"fontSize": 14,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Platelets low + splenomegaly -> portal hypertension / cardiac cirrhosis? Pre-LVAD/transplant: persistent hyperbilirubinemia + abnormal imaging",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "synth_f",
			"type": "text",
			"x": 36,
			"y": 2100,
			"width": 1088.83447265625,
			"height": 17.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
