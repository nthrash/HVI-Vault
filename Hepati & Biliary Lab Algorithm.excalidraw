			"seed": 847691628,
			"version": 154,
			"versionNonce": 1674339672,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778901110196,
			"locked": false,
			"text": "ACLI / Ischemic\nHepatitis\n2-hit model:\ncongestion +\nhypoperfusion\n\nDx clues:\n- ALT:LDH <1.5\n- Peak d1-3\n- 50% fall in 72h\n- Prothrombin drops 80-\n84% (vs viral)\n\nRx:\n- Restore CO\n- Inotropes, MCS\n- O2 if hypoxic",
			"fontSize": 10.296983928273148,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "ACLI / Ischemic\nHepatitis\n2-hit model:\ncongestion +\nhypoperfusion\n\nDx clues:\n- ALT:LDH <1.5\n- Peak d1-3\n- 50% fall in 72h\n- Prothrombin drops 80-84% (vs viral)\n\nRx:\n- Restore CO\n- Inotropes, MCS\n- O2 if hypoxic",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": "ACLI / Ischemic\nHepatitis\n2-hit model:\ncongestion +\nhypoperfusion\n\nDx clues:\n- ALT:LDH <1.5\n- Peak d1-3\n- 50% fall in 72h\n- Prothrombin drops 80-84% (vs viral)\n\nRx:\n- Restore CO\n- Inotropes, MCS\n- O2 if hypoxic"
		},
