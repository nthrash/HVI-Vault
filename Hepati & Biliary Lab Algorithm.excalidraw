			"version": 20,
			"versionNonce": 2048622376,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778901163092,
			"link": null,
			"locked": false,
			"text": "ACLI: rapid rise d1-3 -> 50% fall within 72h of hemo stabilization -> normalization d7-10\nFailure to decline after hemodynamic stabilization -> reassess: ongoing ischemia,\nDILI, viral hepatitis, or primary liver disease\nLow AST/ALT: pyridoxine (B6) deficiency or advanced sarcopenia/cachexia",
			"fontSize": 13,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "ACLI: rapid rise d1-3 -> 50% fall within 72h of hemo stabilization -> normalization d7-10\nFailure to decline after hemodynamic stabilization -> reassess: ongoing ischemia,\nDILI, viral hepatitis, or primary liver disease\nLow AST/ALT: pyridoxine (B6) deficiency or advanced sarcopenia/cachexia",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
