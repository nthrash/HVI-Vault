		{
			"id": "s2_low_b",
			"type": "text",
			"x": 650,
			"y": 920,
			"width": 536.6510620117188,
			"height": 60,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aZ",
			"roundness": null,
			"seed": 1825606740,
			"version": 2,
			"versionNonce": 1666379244,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778899739690,
			"link": null,
			"locked": false,
			"text": "- Acute severe illness (most common ICU cause)  - Malnutrition / Zn or Mg deficiency\n- Hypothyroidism  - Bisphosphonates/denosumab  - Wilson disease / pernicious anemia\n- Hypophosphatasia (rare genetic): persistent low ALP + MSK sx/fractures/dental anomalies\n  -> Check pyridoxal-5-phosphate (PLP) + phosphoethanolamine",
			"fontSize": 12,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "- Acute severe illness (most common ICU cause)  - Malnutrition / Zn or Mg deficiency\n- Hypothyroidism  - Bisphosphonates/denosumab  - Wilson disease / pernicious anemia\n- Hypophosphatasia (rare genetic): persistent low ALP + MSK sx/fractures/dental anomalies\n  -> Check pyridoxal-5-phosphate (PLP) + phosphoethanolamine",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
